@model AutoServiceApp.Dtos.CarDto

<h1>Detail auta</h1>

<div class="mb-3">
    <p><strong>Značka:</strong> @Model.Brand</p>
    <p><strong>Model:</strong> @Model.Model</p>
    <p><strong>Rok:</strong> @Model.Year</p>
    <p><strong>SPZ:</strong> @Model.LicensePlate</p>
    <p><strong>Majitel:</strong> @Model.CustomerName</p>
</div>

<h4>Servisní zakázky</h4>
@if (Model.ServiceOrders.Any())
{
    <ul class="list-group mb-3">
        @foreach (var order in Model.ServiceOrders)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@order.CreatedAt.ToLocalTime() - @order.Status</span>
                <a asp-controller="ServiceOrders" asp-action="Detail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Detail zakázky</a>
            </li>
        }
    </ul>
}
else
{
    <p>Auto zatím nemá žádné servisní zakázky.</p>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Zpět</a>