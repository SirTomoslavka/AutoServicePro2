@model IList<AutoServiceApp.Dtos.CarDto>

<h1>Auta</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nové auto</a>
</p>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Značka</th>
        <th>Model</th>
        <th>Rok</th>
        <th>SPZ</th>
        <th>Majitel</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Brand</td>
            <td>@item.Model</td>
            <td>@item.Year</td>
            <td>@item.LicensePlate</td>
            <td>@item.CustomerName</td>
            <td>
                <a asp-action="Detail" asp-route-id="@item.Id">Detail</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>