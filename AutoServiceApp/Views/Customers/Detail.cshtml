@model AutoServiceApp.Models.Customer

<h1>Detail zákazníka</h1>

<div class="mb-3">
    <p><strong>Jméno:</strong> @Model.FullName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Telefon:</strong> @Model.Phone</p>
</div>

<h4>Auta zákazníka</h4>
@if (Model.Cars.Any())
{
    <ul class="list-group mb-3">
        @foreach (var car in Model.Cars)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@car.Brand @car.Model (@car.LicensePlate)</span>
                <a asp-controller="Cars" asp-action="Detail" asp-route-id="@car.Id" class="btn btn-sm btn-outline-primary">Detail auta</a>
            </li>
        }
    </ul>
}
else
{
    <p>Zákazník zatím nemá žádná auta.</p>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Zpět</a>