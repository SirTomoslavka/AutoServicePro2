@model IList<AutoServiceApp.Dtos.InvoiceDto>

<h1>Faktury</h1>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Číslo faktury</th>
        <th>Datum vystavení</th>
        <th>Částka</th>
        <th>Stav</th>
        <th>Zákazník</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.InvoiceNumber</td>
            <td>@item.IssuedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
            <td>@item.TotalAmount.ToString("N2") Kč</td>
            <td>
                @if (item.IsPaid)
                {
                    <span class="badge bg-success">Zaplaceno</span>
                }
                else
                {
                    <span class="badge bg-danger">Nezaplaceno</span>
                }
            </td>
            <td>@item.CustomerName</td>
            <td>
                <a asp-action="Detail" asp-route-id="@item.Id">Detail</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Smazat</a>
            </td>
        </tr>
    }
    </tbody>
</table>
