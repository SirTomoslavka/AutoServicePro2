@model IEnumerable<AutoServiceApp.Models.Mechanic>

<h1>Mechanici</h1>

<a asp-action="Create" class="btn btn-primary mb-3">Nový</a>

<table class="table">
    <thead>
    <tr>
        <th>Jméno</th>
        <th>Specializace</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.FullName</td>
            <td>@m.Specialization</td>
        </tr>
    }
    </tbody>
</table>