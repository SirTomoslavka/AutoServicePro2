@model AutoServiceApp.ViewModels.ServiceOrderFormViewModel

<h1>Upravit zakázku</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ServiceOrder.Id" />
    <input type="hidden" asp-for="ServiceOrder.CreatedAt" />
    <input type="hidden" asp-for="ServiceOrder.Status" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ServiceOrder.CarId" class="form-label">Auto</label>
        <select asp-for="ServiceOrder.CarId" asp-items="Model.Cars" class="form-select">
            <option value="">-- Vyberte auto --</option>
        </select>
        <span asp-validation-for="ServiceOrder.CarId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ServiceOrder.Description" class="form-label">Popis</label>
        <textarea asp-for="ServiceOrder.Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ServiceOrder.Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Uložit</button>
    <a asp-action="Index" class="btn btn-secondary">Zpět</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
