@model AutoServiceApp.Models.SparePart

<h1>Smazat díl</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<p>Opravdu chceš smazat díl <strong>@Model.Name</strong>?</p>

<div class="mb-3">
    <p><strong>Katalogové číslo:</strong> @(Model.CatalogNumber ?? "—")</p>
    <p><strong>Cena:</strong> @Model.UnitPrice.ToString("N2") Kč</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Smazat</button>
    <a asp-action="Index" class="btn btn-secondary">Zpět</a>
</form>
